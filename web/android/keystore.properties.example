# Copy this file to web/android/keystore.properties and replace every placeholder locally.
# Do not commit the copied file, a keystore, passwords, or aliases.
# CI should provide the corresponding ANDROID_RELEASE_* environment variables instead.
RELEASE_STORE_FILE=<absolute-path-to-release-keystore>
RELEASE_STORE_PASSWORD=<local-only-value>
RELEASE_KEY_ALIAS=<local-only-value>
RELEASE_KEY_PASSWORD=<local-only-value>
