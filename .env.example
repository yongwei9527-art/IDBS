NODE_ENV=development
PORT=3000
HOST=127.0.0.1
ADMIN_PASSWORD=generated-by-installer
TOKEN_SECRET=generated-by-installer
# Public mobile-app configuration. APP_PAIRING_SECRET stays only on the server.
APP_NAME=Laboratory Management System
APP_PUBLIC_URL=https://lab.example.com
APP_PAIRING_SECRET=generated-by-installer
APP_PAIRING_TTL_MINUTES=10
APK_DOWNLOAD_URL=https://lab.example.com/download/app.apk
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ADMIN_OPENIDS=
# Firebase Cloud Messaging HTTP v1 service account. Base64 is preferred for .env safety.
# Configure only in deployment secrets; never commit either value. Raw JSON remains a legacy fallback.
# FCM_SERVICE_ACCOUNT_JSON_BASE64=
# FCM_SERVICE_ACCOUNT_JSON=
UPLOAD_DIR=/var/www/laboratory-management-system/uploads
# Finished export files are private and downloaded only through the authenticated API.
EXPORT_DIR=/var/www/laboratory-management-system/exports
EXPORT_RETENTION_DAYS=30
DATABASE_URL=postgresql://laboratory_management_system_user:generated-by-installer@127.0.0.1:5432/laboratory_management_system
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PGSSL_CA=
# APK uses https://localhost as its WebView origin. Keep it in CORS_ORIGIN when using APK.
# Domain production: CORS_ORIGIN=https://localhost,https://your-lab-domain.example
# No-domain/IP mode: CORS_ORIGIN=https://localhost,http://your-server-ip
CORS_ORIGIN=https://localhost,http://your-server-ip
TRUST_PROXY=false
# Use false only for isolated validation; production should keep scheduled maintenance and reports enabled.
ENABLE_SCHEDULERS=true
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=600000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# Database backup (npm run db:backup)
BACKUP_DIR=backups/db
BACKUP_RETENTION_DAYS=14
BACKUP_FORMAT=custom
# PG_DUMP_PATH=C:\\Program Files\\PostgreSQL\\16\\bin\\pg_dump.exe

# Production hardening notes:
# NODE_ENV=production
# TRUST_PROXY=true
# CORS_ORIGIN=https://localhost,https://your-lab-domain.example
# AUTH_RATE_LIMIT_MAX=5
# API_RATE_LIMIT_MAX=90

# PostgreSQL performance / observability
PGPOOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000
PG_SLOW_QUERY_MS=200

# Orphan upload cleanup (npm run uploads:cleanup)
UPLOAD_ORPHAN_MAX_AGE_DAYS=30
